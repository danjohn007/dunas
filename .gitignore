# Logs
logs/*
!logs/.gitkeep

# Uploads
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/units/.gitkeep
!public/uploads/drivers/.gitkeep

# Imagenes (plate detection images)
public/Imagenes/*
!public/Imagenes/.gitkeep
imagenes/*
!imagenes/.gitkeep
!imagenes/README.md

# Large binary files and installers
drivers/*.zip
drivers/*.exe
drivers/**/*.exe
drivers/**/*.zip
drivers/**/agent.log

# Sistema operativo
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Configuración local
config/config.local.php

# Archivos temporales
*.tmp
*.swp
*.swo
*~

# Dependencias (si se usan)
vendor/
node_modules/

# Cache
cache/
*.cache
